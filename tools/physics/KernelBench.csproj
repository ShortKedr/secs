<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">obj/KernelBench/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="KernelBench.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(StudyAssemblies)' == ''">
    <ProjectReference Include="../../SpaceBattle.Core/SpaceBattle.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(StudyAssemblies)' != ''">
    <Reference Include="SpaceBattle.Core">
      <HintPath>$(StudyAssemblies)/SpaceBattle.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
