+    private bool HasSweepCandidate(PhysicsVector start, PhysicsVector end, PhysicsVector offset, bool hasOffsetRays)
+    {
+        if (!float.IsFinite(offset.X) || !float.IsFinite(offset.Y)) return true;
+        var bounds = new AABB { LowerBound = start, UpperBound = start };
+        IncludeSweepEndpoints(ref bounds, start, end);
+        if (hasOffsetRays)
+        {
+            IncludeSweepEndpoints(ref bounds, start + offset, end + offset);
+            IncludeSweepEndpoints(ref bounds, start - offset, end - offset);
+            offset *= 0.5f;
+            IncludeSweepEndpoints(ref bounds, start + offset, end + offset);
+            IncludeSweepEndpoints(ref bounds, start - offset, end - offset);
+        }
+        // Enclose the actual rounded rays and origin queries, with extra rounding slack.
+        var magnitude = MathF.Max(1f, MathF.Max(
+            MathF.Max(MathF.Abs(bounds.LowerBound.X), MathF.Abs(bounds.LowerBound.Y)),
+            MathF.Max(MathF.Abs(bounds.UpperBound.X), MathF.Abs(bounds.UpperBound.Y))));
+        var padding = PointQueryEpsilon + magnitude * 0.000001f;
+        bounds.LowerBound = new PhysicsVector(
+            MathF.BitDecrement(bounds.LowerBound.X - padding),
+            MathF.BitDecrement(bounds.LowerBound.Y - padding));
+        bounds.UpperBound = new PhysicsVector(
