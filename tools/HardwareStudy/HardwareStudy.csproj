<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(StudyAssemblies)' == ''">
    <ProjectReference Include="../../SpaceBattle.Core/SpaceBattle.Core.csproj" />
    <ProjectReference Include="../../SpaceBattle.SKECS/SpaceBattle.SKECS.csproj" />
    <ProjectReference Include="../../SpaceBattle.Adapters/SpaceBattle.Adapters.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(StudyAssemblies)' != ''">
    <Reference Include="SpaceBattle.Core"><HintPath>$(StudyAssemblies)/SpaceBattle.Core.dll</HintPath></Reference>
    <Reference Include="SpaceBattle.SKECS"><HintPath>$(StudyAssemblies)/SpaceBattle.SKECS.dll</HintPath></Reference>
    <Reference Include="SpaceBattle.Adapters"><HintPath>$(StudyAssemblies)/SpaceBattle.Adapters.dll</HintPath></Reference>
    <Reference Include="SKECS"><HintPath>$(StudyAssemblies)/SKECS.dll</HintPath></Reference>
    <Reference Include="Scellecs.Morpeh"><HintPath>$(StudyAssemblies)/Scellecs.Morpeh.dll</HintPath></Reference>
    <Reference Include="StaticLibrary"><HintPath>$(StudyAssemblies)/StaticLibrary.dll</HintPath></Reference>
  </ItemGroup>
</Project>
